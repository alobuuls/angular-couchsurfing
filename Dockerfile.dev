# syntax=docker/dockerfile:1

FROM node:20.20.2-alpine AS dev

WORKDIR /docker-cs-app

COPY package*.json ./

RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts

COPY . .

EXPOSE 4200

CMD ["npm", "start", "--", "--host", "0.0.0.0", "--poll", "1000", "--proxy-config", "proxy.docker.conf.json"]
